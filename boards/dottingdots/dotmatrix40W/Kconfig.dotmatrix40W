config BOARD_DOTMATRIX40W
    select SOC_NRF52840_QIAA

    # Bootloader Support
    select ZMK_BOARD_COMPAT if BOARD_DOTMATRIX40W_NRF52840_ZMK
    imply RETAINED_MEM if BOARD_DOTMATRIX40W_NRF52840_ZMK
    imply RETENTION if BOARD_DOTMATRIX40W_NRF52840_ZMK
    imply RETENTION_BOOT_MODE if BOARD_DOTMATRIX40W_NRF52840_ZMK
